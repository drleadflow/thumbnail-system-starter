# ── Database: NONE NEEDED ────────────────────────────────────────────
# Storage is a local SQLite file (./data/starter.sqlite), created
# automatically. Optional: uncomment to use Supabase instead
# (run setup.sql in its SQL editor first).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── YouTube search + transcripts (required) ──────────────────────────
# https://scrapecreators.com — one API for search (real view counts +
# channel ids) AND transcripts. This powers the library, watchlist
# baselines come from YouTube's free RSS (no key needed).
SCRAPECREATORS_API_KEY=your-key

# ── AI: research, hook optimizer, drafting, image generation (required)
# https://openrouter.ai — one key for the LLM calls AND gpt-image-2.
OPENROUTER_API_KEY=your-key

# ── Voice notes → script (optional — pick ONE) ───────────────────────
# Groq is free: https://console.groq.com  (Whisper transcription)
GROQ_API_KEY=
# ...or use an OpenAI key instead (also enables direct OpenAI image gen)
OPENAI_API_KEY=
